{
  "inputs": [
    {
      "type": "promptString",
      "id": "dynatraceOAuthClientSecret",
      "description": "Dynatrace OAuth Client Secret (dt0s02.*). Create an OAuth client in Account > Identity & access > OAuth clients with the scopes listed in MCP_SETUP.md. The client ID is hardcoded below for reference; only the secret is prompted.",
      "password": true
    }
  ],
  "servers": {
    "dynatrace": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@dynatrace-oss/dynatrace-mcp-server@1.8.7"
      ],
      "env": {
        "DT_ENVIRONMENT": "https://waa41263.apps.dynatrace.com",
        "DT_SSO_URL": "https://sso.dynatrace.com",
        "OAUTH_CLIENT_ID": "dt0s02.GANJVRPD",
        "OAUTH_CLIENT_SECRET": "${input:dynatraceOAuthClientSecret}",
        "DT_MCP_DISABLE_TELEMETRY": "true"
      }
    }
  }
}